# Flask Secret Key for session signing
SECRET_KEY=your_flask_secret_key_here

# PostgreSQL Database Connection URL (e.g. postgresql://username:password@localhost:5432/heritage_storyteller)
DATABASE_URL=postgresql://username:password@localhost:5432/heritage_storyteller

# JWT Secret Key for token signing and verification
JWT_SECRET_KEY=your_jwt_secret_key_here

# Backend server port (optional, defaults to 5000)
PORT=5000
